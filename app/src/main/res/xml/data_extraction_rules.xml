<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude unpublished manuscripts, local review cache, and provider credentials from cloud backup -->
        <exclude domain="database" path="paper_critic_sql_database" />
        <exclude domain="database" path="paper_critic_sql_database-shm" />
        <exclude domain="database" path="paper_critic_sql_database-wal" />
        <exclude domain="sharedpref" path="paper_critic_settings.xml" />
    </cloud-backup>
    <device-transfer>
        <!-- Exclude sensitive provider credentials and local manuscript cache from automated device transfer -->
        <exclude domain="database" path="paper_critic_sql_database" />
        <exclude domain="database" path="paper_critic_sql_database-shm" />
        <exclude domain="database" path="paper_critic_sql_database-wal" />
        <exclude domain="sharedpref" path="paper_critic_settings.xml" />
    </device-transfer>
</data-extraction-rules>
