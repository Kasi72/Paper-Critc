rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 1: Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function hasAllowedReviewKeys(d) {
      return d.keys().hasOnly([
        'userId', 'title', 'authors', 'publicationYear', 'venueOrCitation',
        'isEmpirical', 'credibilityScore', 'verdict',
        'methodologyScore', 'significanceScore', 'clarityScore',
        'originalityScore', 'mathRigorScore', 'reproducibilityScore',
        'methodologyJustification', 'significanceJustification', 'clarityJustification',
        'originalityJustification', 'mathRigorJustification', 'reproducibilityJustification',
        'refereeConfidence', 'extractionConfidence', 'reviewMode',
        'coverageDisclosure', 'validationStatus', 'structuredFindingsJson',
        'schemaVersion', 'findingsChunkCount', 'findingsChecksum',
        'abstractSummary', 'researchQuestion', 'keyMethodology', 'coreContributions',
        'redTeamCritique', 'blueTeamVerification', 'mathAuditReport',
        'codeAuditReport', 'editorNote', 'copyeditSuggestions',
        'reviewerQuestions', 'formattedDossier', 'bookmarked',
        'personalNotes', 'createdAt', 'updatedAt'
      ]);
    }

    function isModeAlignedVerdict(mode, verdict) {
      return (mode == 'POST_PUBLICATION_APPRAISAL' && verdict in ['HIGH_CREDIBILITY', 'SOUND_WITH_CAVEATS', 'REQUIRES_CORRECTION', 'MAJOR_CONCERNS', 'LOW_CREDIBILITY', 'INSUFFICIENT_EVIDENCE_FOR_ASSESSMENT', 'PROVISIONAL_APPRAISAL_DESIGN_UNCERTAIN']) ||
             (mode == 'JOURNAL_REFEREE' && verdict in ['ACCEPT', 'MINOR_REVISION', 'MINOR_REVISION_WITH_CAVEATS', 'MAJOR_REVISION', 'REJECT_AND_RESUBMIT', 'REJECT', 'INSUFFICIENT_EVIDENCE_FOR_ASSESSMENT', 'PROVISIONAL_APPRAISAL_DESIGN_UNCERTAIN']) ||
             (mode == 'CLINICAL_EVIDENCE_APPRAISAL' && verdict in ['HIGH_CERTAINTY', 'MODERATE_CERTAINTY', 'LOW_CERTAINTY', 'VERY_LOW_CERTAINTY', 'INSUFFICIENT_EVIDENCE_FOR_ASSESSMENT', 'PROVISIONAL_APPRAISAL_DESIGN_UNCERTAIN']);
    }

    function isLegacyReviewSchema(d) {
      return !d.keys().hasAny([
               'methodologyScore', 'significanceScore', 'clarityScore',
               'originalityScore', 'mathRigorScore', 'reproducibilityScore'
             ]) &&
             d.verdict in ['ACCEPT', 'MINOR_REVISION', 'MAJOR_REVISION', 'REJECT_AND_RESUBMIT', 'REJECT'];
    }

    function isV4RubricConsistent(d) {
      let m = d.methodologyScore;
      let s = d.significanceScore;
      let c = d.clarityScore;
      let o = d.originalityScore;
      let r = d.mathRigorScore;
      let p = d.reproducibilityScore;
      return m is int && m >= 1 && m <= 10 &&
             s is int && s >= 1 && s <= 10 &&
             c is int && c >= 1 && c <= 10 &&
             o is int && o >= 1 && o <= 10 &&
             r is int && r >= 1 && r <= 10 &&
             p is int && p >= 1 && p <= 10 &&
             d.credibilityScore == int((m * 25 + s * 20 + c * 15 + o * 15 + r * 15 + p * 10 + 5) / 10);
    }

    function isValidCoreReview(d) {
      return d.userId == request.auth.uid &&
             d.title is string && d.title != '' && d.title.size() <= 500 &&
             d.authors is string && d.authors != '' && d.authors.size() <= 500 &&
             d.publicationYear is string && d.publicationYear.size() <= 40 &&
             d.venueOrCitation is string && d.venueOrCitation.size() <= 500 &&
             d.isEmpirical is bool &&
             d.credibilityScore is int && d.credibilityScore >= 0 && d.credibilityScore <= 100 &&
             (('reviewMode' in d)
               ? (isModeAlignedVerdict(d.reviewMode, d.verdict) &&
                  d.keys().hasAll(['methodologyScore', 'significanceScore', 'clarityScore', 'originalityScore', 'mathRigorScore', 'reproducibilityScore']) &&
                  isV4RubricConsistent(d))
               : isLegacyReviewSchema(d)) &&
             d.abstractSummary is string && d.abstractSummary.size() <= 5000 &&
             d.researchQuestion is string && d.researchQuestion.size() <= 3000 &&
             d.keyMethodology is string && d.keyMethodology.size() <= 4000 &&
             d.coreContributions is string && d.coreContributions.size() <= 6000 &&
             d.redTeamCritique is string && d.redTeamCritique.size() <= 12000 &&
             d.blueTeamVerification is string && d.blueTeamVerification.size() <= 10000 &&
             d.mathAuditReport is string && d.mathAuditReport.size() <= 8000 &&
             d.codeAuditReport is string && d.codeAuditReport.size() <= 8000 &&
             d.editorNote is string && d.editorNote.size() <= 8000 &&
             d.copyeditSuggestions is string && d.copyeditSuggestions.size() <= 8000 &&
             d.reviewerQuestions is string && d.reviewerQuestions.size() <= 8000 &&
             d.formattedDossier is string && d.formattedDossier != '' && d.formattedDossier.size() <= 40000 &&
             d.bookmarked is bool &&
             d.personalNotes is string && d.personalNotes.size() <= 5000 &&
             d.createdAt is timestamp && d.createdAt <= request.time &&
             d.updatedAt is timestamp && d.updatedAt <= request.time;
    }

    function isValidJustifications(d) {
      let mj = d.get('methodologyJustification', '');
      let sj = d.get('significanceJustification', '');
      let cj = d.get('clarityJustification', '');
      let oj = d.get('originalityJustification', '');
      let rj = d.get('mathRigorJustification', '');
      let pj = d.get('reproducibilityJustification', '');
      return mj is string && mj.size() <= 4000 &&
             sj is string && sj.size() <= 4000 &&
             cj is string && cj.size() <= 4000 &&
             oj is string && oj.size() <= 4000 &&
             rj is string && rj.size() <= 4000 &&
             pj is string && pj.size() <= 4000;
    }

    function isValidAuditMeta(d) {
      let rc = d.get('refereeConfidence', 3);
      let ec = d.get('extractionConfidence', 3);
      let cd = d.get('coverageDisclosure', '');
      let sf = d.get('structuredFindingsJson', '');
      let sv = d.get('schemaVersion', 5);
      let fc = d.get('findingsChunkCount', 0);
      let cs = d.get('findingsChecksum', '');
      return rc is int && rc >= 1 && rc <= 5 &&
             ec is int && ec >= 1 && ec <= 5 &&
             cd is string && cd.size() <= 2000 &&
             d.get('validationStatus', 'LEGACY_UNVALIDATED') in ['VERIFIED', 'ADJUDICATED_WITH_CAVEATS', 'PARTIALLY_VALIDATED', 'PROVISIONAL', 'UNVERIFIED', 'LEGACY_UNVALIDATED', 'REQUIRES_REANALYSIS'] &&
             sf is string && sf.size() <= 60000 &&
             sv is int && sv >= 1 && sv <= 20 &&
             fc is int && fc >= 0 && fc <= 64 &&
             cs is string && cs.size() <= 128;
    }

    function isValidPartialFieldUpdate(next, prev) {
      let changed = next.diff(prev).affectedKeys();
      return next.updatedAt is timestamp && next.updatedAt <= request.time &&
             (
               (changed.hasOnly(['bookmarked', 'updatedAt']) && next.bookmarked is bool) ||
               (changed.hasOnly(['personalNotes', 'updatedAt']) && next.personalNotes is string && next.personalNotes.size() <= 5000)
             );
    }

    function isValidFindingsChunk(d) {
      return d.keys().hasOnly(['userId', 'chunkIndex', 'totalChunks', 'payload', 'checksum']) &&
             d.userId == request.auth.uid &&
             d.chunkIndex is int && d.chunkIndex >= 0 && d.chunkIndex < 64 &&
             d.totalChunks is int && d.totalChunks >= 1 && d.totalChunks <= 64 &&
             d.chunkIndex < d.totalChunks &&
             d.payload is string && d.payload != '' && d.payload.size() <= 55000 &&
             d.checksum is string && d.checksum.size() <= 128;
    }

    match /users/{userId}/reviews/{reviewId} {
      allow get: if isOwner(userId) && isValidId(reviewId) && resource.data.userId == request.auth.uid;
      allow list: if isOwner(userId);

      allow create: if isOwner(userId) &&
                       isValidId(reviewId) &&
                       hasAllowedReviewKeys(request.resource.data) &&
                       isValidCoreReview(request.resource.data) &&
                       isValidJustifications(request.resource.data) &&
                       isValidAuditMeta(request.resource.data);

      allow update: if isOwner(userId) &&
                       isValidId(reviewId) &&
                       request.resource.data.userId == resource.data.userId &&
                       request.resource.data.createdAt == resource.data.createdAt &&
                       (
                         isValidPartialFieldUpdate(request.resource.data, resource.data) ||
                         (hasAllowedReviewKeys(request.resource.data) &&
                          isValidCoreReview(request.resource.data) &&
                          isValidJustifications(request.resource.data) &&
                          isValidAuditMeta(request.resource.data))
                       );

      allow delete: if isOwner(userId) && isValidId(reviewId) && resource.data.userId == request.auth.uid;

      match /findings_chunks/{chunkId} {
        allow get: if isOwner(userId) && isValidId(reviewId) && isValidId(chunkId) && resource.data.userId == request.auth.uid;
        allow list: if isOwner(userId) && isValidId(reviewId);
        allow create: if isOwner(userId) && isValidId(reviewId) && isValidId(chunkId) && isValidFindingsChunk(request.resource.data);
        allow update: if isOwner(userId) && isValidId(reviewId) && isValidId(chunkId) &&
                         isValidFindingsChunk(request.resource.data) &&
                         request.resource.data.userId == resource.data.userId;
        allow delete: if isOwner(userId) && isValidId(reviewId) && isValidId(chunkId) && resource.data.userId == request.auth.uid;
      }
    }
  }
}
